# Public URL of the live site.
# Used for: og:image, canonical, hreflang, sitemap.xml, robots.txt, llms.txt and JSON-LD.
#
# Local development: leave empty -> falls back to site.config.ts baseUrl.
# Production (Vercel): set NUXT_PUBLIC_SITE_URL to the real domain.
# (SITE_URL also works, but is only read at build time; NUXT_PUBLIC_SITE_URL
#  is honoured both at build time AND at runtime by Nuxt/Nitro.)
#   NUXT_PUBLIC_SITE_URL=https://dr-ghadir-dental.vercel.app
NUXT_PUBLIC_SITE_URL=